{
  "name": "pencil-annotation",
  "version": "0.2.4",
  "description": "Apple Pencil handwriting / annotation layer for SiYuan documents",
  "type": "module",
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "vite build && node scripts/copy-assets.mjs",
    "deploy": "node scripts/copy-assets.mjs",
    "pack": "npm run build && node scripts/pack.mjs",
    "harness": "vite --port 5199",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "siyuan",
    "plugin",
    "draw",
    "pencil",
    "handwriting",
    "annotation"
  ],
  "license": "MIT",
  "devDependencies": {
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  },
  "dependencies": {
    "jspdf": "^4.2.1",
    "modern-screenshot": "^4.7.0",
    "perfect-freehand": "^1.2.2",
    "siyuan": "^1.0.8"
  }
}
